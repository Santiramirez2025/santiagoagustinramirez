# === Variables de entorno (cargar con `vercel env add` en Production/Preview/Development) ===
# NUNCA commitear los valores reales. Este archivo es solo la plantilla.

# --- Base de datos (Neon Postgres, vía Vercel Marketplace) ---
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# --- Mercado Pago (panel de desarrolladores) ---
MP_ACCESS_TOKEN="APP_USR-..."         # Access Token (privado, server)
MP_PUBLIC_KEY="APP_USR-..."           # Public Key (opcional, si se usa Bricks)
MP_WEBHOOK_SECRET="..."               # Secret para validar la firma del webhook
MP_CURRENCY="ARS"                     # ARS (recomendado) o USD
USD_ARS_RATE="1000"                   # Tipo de cambio USD->ARS (si MP_CURRENCY=ARS)

# --- Modelo de seña ---
DEPOSIT_PCT="0.30"                    # % del proyecto que se cobra como seña
DEPOSIT_MIN_USD="150"                 # seña mínima en USD

# --- Asistente IA (Claude) ---
ANTHROPIC_API_KEY="sk-ant-..."       # requerido para el asistente en producción
ASSISTANT_MODEL="claude-opus-4-8"    # opcional: bajá a claude-haiku-4-5 para recortar costo en tráfico alto

# --- Meta / Conversions API ---
META_PIXEL_ID="1419051696174763"      # dataset canónico (el mismo que usa el Pixel del navegador)
META_CAPI_ACCESS_TOKEN="..."          # token de Conversions API
META_TEST_EVENT_CODE=""               # opcional: código de la herramienta de eventos de prueba

# --- Google Calendar (service account con acceso al calendario) ---
GOOGLE_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
GOOGLE_CALENDAR_ID="tucorreo@gmail.com"

# --- Bookings (opcional, tienen defaults) ---
BOOKING_STARTS="10:00,12:00,15:00,17:00"
BOOKING_HORIZON_DAYS="21"
